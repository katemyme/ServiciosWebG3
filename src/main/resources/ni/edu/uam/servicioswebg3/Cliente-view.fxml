<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_LEFT" prefHeight="537.0" prefWidth="1103.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.servicioswebg3.Controller.ClienteController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Consulta de clientes - API REST">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="10.0">

        <Button fx:id="btnConsultar" mnemonicParsing="false" onAction="#consultarClientes" text="Consultar clientes" />

        <Label fx:id="lblEstado" text="Presione Consultar clientes" />

    </HBox>

    <TableView fx:id="tablaClientes" prefHeight="420.0" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
            <TableColumn fx:id="colEmail" prefWidth="190.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
            <TableColumn fx:id="colFechaNacimiento" prefWidth="95.0" text="Nacimiento" />
            <TableColumn fx:id="colPais" prefWidth="85.0" text="País" />
            <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
            <TableColumn fx:id="colDireccion" prefWidth="160.0" text="Dirección" />
            <TableColumn fx:id="colIngreso" prefWidth="100.0" text="Ingreso anual" />
            <TableColumn fx:id="colPuntaje" prefWidth="80.0" text="Score" />
            <TableColumn fx:id="colTieneDeuda" prefWidth="60.0" text="Deuda" />
            <TableColumn fx:id="colMontoDeuda" prefWidth="95.0" text="Monto deuda" />
            <TableColumn fx:id="colEstado" prefWidth="75.0" text="Estado" />
        </columns>

        <placeholder>
            <Label text="Tabla sin contenido" />
        </placeholder>

    </TableView>

</VBox>
