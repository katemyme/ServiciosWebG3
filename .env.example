# Copie este archivo como ".env" (en la raíz del proyecto) y ponga sus valores reales.
# El archivo .env NO se sube a git.

# URL completa del endpoint que devuelve la lista de clientes (JSON)
CLIENTES_API_URL=https://su-servicio.example.com/rest/v1/clientes

# Llave del servicio (opcional). Si se define, se envía en los headers
# "apikey" y "Authorization: Bearer ..." (formato usado por Supabase).
CLIENTES_API_KEY=
